# Copy to .env and edit. .env is git-ignored; never commit real values.
SG_PORT=8080
# Address the port is published on. Default 0.0.0.0 (all interfaces); 127.0.0.1 = this host only, behind a TLS reverse proxy
# SG_BIND=127.0.0.1
# Set a strong password to require login for the UI and management API
SG_ADMIN_USER=admin
SG_ADMIN_PASSWORD=
# Optional: encryption key for stored upstream API keys (otherwise generated in the data volume)
# SG_SECRET_KEY=
# SG_CORS_ORIGINS=
# SG_REDIS_URL=redis://redis:6379/0
