SG_PORT=8080
# Address the port is published on. Default 0.0.0.0 (all interfaces); 127.0.0.1 = this host only, behind a TLS reverse proxy
# SG_BIND=127.0.0.1
SG_ADMIN_USER=admin
# REQUIRED: choose a long random password. If left empty, a random one is generated and printed in the container log.
SG_ADMIN_PASSWORD=
# SG_SECRET_KEY=
# SG_CORS_ORIGINS=
# SG_REDIS_URL=redis://redis:6379/0
# SG_IMAGE=registry.example.com/smartgateway:latest
